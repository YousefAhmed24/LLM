import os
import shutil

# 1. Locate the clean original script in your Kaggle input
source_path = None
for root, dirs, files in os.walk('/kaggle/input'):
    if 'finetune_synthetic.py' in files:
        source_path = os.path.join(root, 'finetune_synthetic.py')
        break

# 2. Copy it to the working directory to overwrite the corrupted file
work_path = '/kaggle/working/finetune_synthetic.py'
shutil.copy(source_path, work_path)

# 3. Read all lines
with open(work_path, 'r') as f:
    lines = f.readlines()

# 4. Patch the specific line while matching its exact leading whitespace
with open(work_path, 'w') as f:
    for line in lines:
        if "m.load_state_dict(torch.load('gpt_weights.pt'" in line:
            # Grab exactly however many spaces/tabs are at the start of this line
            indent = line[:len(line) - len(line.lstrip())]
            
            # Inject the new logic using that exact spacing
            f.write(f"{indent}checkpoint = torch.load('gpt_weights.pt', map_location=device, weights_only=True)\n")
            f.write(f"{indent}if 'model_state_dict' in checkpoint:\n")
            f.write(f"{indent}    m.load_state_dict(checkpoint['model_state_dict'])\n")
            f.write(f"{indent}else:\n")
            f.write(f"{indent}    m.load_state_dict(checkpoint)\n")
        else:
            f.write(line)

print("✅ finetune_synthetic.py perfectly indented and patched!")


get_ipython().getoutput("pip install -q faker tiktoken python-dotenv datasets")
    
# Execute the script
get_ipython().getoutput("python finetune_synthetic.py")
